// Constructs the workspace models do not use, so `check.sh` still parses them.
// Semantically this is nonsense on purpose: only the grammar is under test.
import "cov.fsm"
import "cov.scenex"

ns app = "https://example.org/models/coverage/"
ns cov_fsm = 'https://example.org/models/coverage/fsm/'

exec-context (ns=app) cov_exec {
    runs-scene: <cov_scene>
    platform:   real-world {
        <agents.arm> realized by KinovaGen3-2F85,
        <arm.wrist_ft> realized by RobotiqFT300s
    }
    config:     "robot.toml"
    timestep:   1.0 ms
}

ros (ns=app) {
    publishers {
        bdd-events: topic "/bdd/events" message "bdd_ros2_interfaces/msg/Event"
    },
    action-servers {
        collab-bhv: action "/bdd/collab_bhv_server" type "bdd_ros2_interfaces/action/Behaviour" {
            on-goal: produce event <cov_fsm.E_TRIGGER>
        }
    },
    always {
        publish at 10.0 Hz to <ros.publishers.bdd-events> with {
            <cov_fsm.E_TRIGGER>: <shared.world.ee>,
            <cov_fsm.E_DONE>: <shared.world.ee>
        }
    }
}

context (ns=app) shared {
    world {
        pose ee {
            of: <gripper.pinch>, wrt: <arm.base>, as-seen-by: <arm.base>
        },
        wrench ft {
            of: <arm.wrist>, wrt: <arm.base>, as-seen-by: <arm.base>,
            ft-sensor: <arm.wrist_ft>
        },
        joint-position elbow {
            joint: <arm.elbow_joint>,
            normalization: (-pi, pi) rad
        }
    },
    spec {
        length band = 0.01 m,
        angle band-rot = 0.01 rad,
        velocity-profile creep-profile = profile {
            max-velocity: 0.02 m/s,
            max-acceleration: 0.05 m/s^2,
            shape: trapezoidal
        },
        admittance adm = {
            force: <shared.world.ft>.force.z,
            mass: 1.0,
            damping: 20.0,
            stiffness: 0.0,
            max-velocity: 0.1 m/s
        },
        // A pose the deployment states: `[config.<key>]` looks into robot.toml, and `for`
        // takes the frames from the quantity it is a value for.
        pose parked = [config.poses.home] for <shared.world.ee>,
        pose staged = [config.cell.stations.handover] for <shared.world.ee>
    }
}

tolerances {
    position: 0.01 m,
    orientation: 0.01 rad
}

guarded-motion (ns=app) cover {
    description: "Every value shape the grammar allows"

    context {
        spec {
            length lift = 0.2 m,
            length shifted = <shared.spec.band> + <spec.lift>,
            length under-tip = <shared.spec.band> - <spec.lift>,
            pose here = snapshot of <shared.world.ee> on event <cov_fsm.E_TRIGGER>,
            pose built = {
                position: (0.1, 0.2, 0.3) m,
                orientation: quat { xyzw: (0.0, 0.0, 0.0, 1.0) }
            },
            pose turned = {
                position: <spec.built>,
                orientation: <spec.built> rotated in <arm.base> by
                    euler { axes: zyx extrinsic, angles: (0.0, 0.0, 1.57) rad }
            },
            wrench push = { torque: (0.0, 0.0, 0.0) Nm, force: (0.0, 0.0, 5.0) N },
            velocity-twist glide = {
                angular-velocity: (0.0, 0.0, 0.0) rad/s,
                linear-velocity: (0.1, 0.0, 0.0) m/s
            },
            path road = lerp {
                start: <spec.built>,
                goal:  <spec.turned>
            }
        }
    }

    when {
        ready: <shared.world.elbow> outside <shared.spec.band> and <spec.lift>
    }

    while {
        tan:  moving <shared.world.ee> along <spec.road> with <shared.spec.creep-profile>,
        park: keeping <shared.world.ee>.position    equal to <shared.spec.parked>.position within <shared.spec.band>,
        aim:  keeping <shared.world.ee>.orientation equal to <shared.spec.staged>.orientation within <shared.spec.band-rot>,
        span: <shared.world.ee>.position.x between <shared.spec.band> and <spec.lift>
    }

    until any {
        far: distance between <shared.world.ee> and <shared.spec.parked> greater than <spec.lift>
    }
}

constraint-handler (ns=app) cover-handler {
    handles: <cover>

    monitors {
        m1: monitor <cover.until> {
            satisfied for 0.2 s {
                trigger: event <cov_fsm.E_DONE>,
                publish: to <ros.publishers.bdd-events> { result.trinary.value: TRUE } at 20.0 Hz
            },
            violated {
                hold: <cover>,
                publish: FALSE to <ros.publishers.bdd-events> at 10.0 Hz,
                result: aborted <ros.action-servers.collab-bhv> { result.trinary.value: FALSE }
            },
        }
    }

    controllers {
        pid ctrl-park { constraint: <cover.park>, Kp: 200, Ki: 100, Kd: 40, decay: 0 },
        impedance ctrl-tan { constraint: <cover.tan>, stiffness: 800, damping: 80 }
            apply at <arm.elbow>
    }

    solvers {
        arm: serial-chain {
            agent: <agents.arm>,
            algorithm: achd,
            gravity: (0.0, 0.0, 9.81) m/s^2
        }
    }
}
